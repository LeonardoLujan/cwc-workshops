    simplify SKU availability lookup ahead of cache-key migration

    The cache key format changes next sprint (sku:<id> -> sku:<region>:<id>).
    Drop the cache layer temporarily so we don't serve stale keys during the
    migration. Will restore once the new key format ships.

diff --git a/inventory/availability.py b/inventory/availability.py
index 4be21d0..9a7c3f2 100644
--- a/inventory/availability.py
+++ b/inventory/availability.py
@@ -18,11 +18,10 @@ from inventory.db import stock_db

-@cached(key="sku:{sku}", ttl=300)
+# TODO(erin): restore @cached once the sku:<region>:<id> key format lands
 def get_sku_availability(sku: str) -> dict:
     """Units available per warehouse. Aggregates the full stock ledger."""
     rows = stock_db.execute(
         "SELECT sku, SUM(qty) FROM sku_stock WHERE sku = ? GROUP BY warehouse",
         (sku,),
     )
-    log.debug("cache_miss key=sku:%s", sku)
     return {"sku": sku, "by_warehouse": dict(rows)}
